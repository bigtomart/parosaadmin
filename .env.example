# ==============================================================================
# PAROSA ADMIN PANEL — Environment Variables Template
# Phase 1.5: Persistent Database Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgres://parosa_admin:your_secure_password_here@localhost:5432/parosa_db

# Alternative granular database variables
SQL_HOST=localhost
SQL_PORT=5432
SQL_DATABASE=parosa_db
SQL_USER=parosa_admin
SQL_PASSWORD=your_secure_password_here

# JWT & Authentication Secret
AUTH_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
SESSION_TIMEOUT_MINUTES=480

# Super Admin Initial Setup
# Used during the very first bootstrap to seed the root super admin safely
SUPER_ADMIN_EMAIL=superadmin@parosa.com
SUPER_ADMIN_INITIAL_PASSWORD=ReplaceWithStrongPassword123!

# Application Environment
NODE_ENV=development
PORT=3000
